{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex History Merger",
  "version": "0.1.0",
  "identifier": "local.codex.history.merger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex History Merger",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
